# AiGlass+ Automation Server - Environment Variables
# Copy this to .env for local testing, or set in Railway dashboard

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
OWNER_PHONE=+1xxxxxxxxxx

# Google (Calendar + Sheets)
CALENDAR_ID=your-email@gmail.com
GOOGLE_SHEETS_ID=your-google-sheets-id
# Paste the ENTIRE contents of your service account JSON as one line:
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Meta Webhook
META_VERIFY_TOKEN=aiglass_webhook_2024
META_APP_SECRET=  # Set this after Meta app webhook is registered

# Optional: OpenAI for AI-enhanced quotes
OPENAI_API_KEY=
